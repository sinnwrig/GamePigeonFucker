<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GamePigeonProtocol\GamePigeonProtocol.csproj" />
    <ProjectReference Include="..\IMessageInterceptor\IMessageInterceptor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="GamePigeonFucker" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Solvers\Collins Scrabble Words (2019).txt" LogicalName="CollinsScrabbleWords2019.txt" />
    <EmbeddedResource Include="Commands\Fonts\Larry3D.flf" LogicalName="Larry3D.flf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Figgle" Version="0.6.6" />
  </ItemGroup>

</Project>
